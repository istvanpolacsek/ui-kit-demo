{
  "framework": "react",
  "styling": "styled-components",
  "libraryName": "nu",
  "dependencies": {
    "install": true
  },
  "stories": {
    "groupByPage": true
  },
  "theme": {
    "cssReset": true,
    "brand": {
      "title": "nu",
      "image": "src/assets/Logo-Color/Type-Default.svg",
      "colorToken": "accent/accentBrand"
    }
  },
  "inputs": {
    "design": ".figma/design.json",
    "enriched": ".figma/design.enriched.json",
    "assets": ".figma/assets.json"
  },
  "paths": {
    "components": "src/components",
    "assetsRoot": "src",
    "theme": "src/providers/ThemeProvider",
    "docs": "src/docs",
    "storybook": ".storybook",
    "tsconfig": "tsconfig.json"
  }
}
